# Provision Server environment configuration
# Copy to .env and fill in real values

# ===== Cloud Provider =====
CLOUD_PROVIDER=vultr

# Vultr API Key
VULTR_API_KEY=

# DigitalOcean API Token
DIGITALOCEAN_TOKEN=

# AWS (only when CLOUD_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SECURITY_GROUP_ID=

# ===== Authentication =====
# Shared secret with Cloudflare Worker (must match PROVISION_SERVER_TOKEN)
SERVER_TOKEN=

# ===== Server =====
# Port to listen on (default: 3001, bound to 127.0.0.1)
PORT=3001
