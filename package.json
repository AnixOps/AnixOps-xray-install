{
  "name": "anixops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:d1": "wrangler d1 execute anixops --local --file=web/workers/db/schema.sql",
    "provision:dev": "cd provision-server && npm run dev",
    "provision:build": "cd provision-server && npm run build",
    "pages:build": "next build && npx @cloudflare/next-on-pages",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name=anixops"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1041.0",
    "next": "^15.1.0",
    "node-ssh": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "stripe": "^17.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@cloudflare/workers-types": "^4.20260503.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "wrangler": "^3.0.0"
  }
}
