# Environment configuration template
# Copy to .env.local and fill in real values

# ===== Cloud Provider =====
# Choose: vultr | digitalocean | aws
CLOUD_PROVIDER=vultr

# Vultr API Key (https://my.vultr.com/settings/#api)
VULTR_API_KEY=

# DigitalOcean API Token (https://cloud.digitalocean.com/account/api/tokens)
DIGITALOCEAN_TOKEN=

# AWS EC2 (only needed when CLOUD_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SECURITY_GROUP_ID=  # Must allow 22/TCP, 443/TCP, 443/UDP inbound

# Default VPS region and plan (Vultr defaults shown)
VPS_REGION=nrt
VPS_PLAN=vhf-1c-1gb

# ===== Rental Mode =====
# Provision Server URL (independent Node.js service)
PROVISION_SERVER_URL=http://127.0.0.1:3001

# Shared secret between Worker and Provision Server (min 32 chars, random string)
PROVISION_SERVER_TOKEN=

# Stripe Payment (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Next.js Pages URL (Stripe redirect target)
FRONTEND_URL=http://localhost:3000

# Renewal reminder notification (optional)
# Telegram Bot: https://api.telegram.org/bot<TOKEN>/sendMessage/<CHAT_ID>
# Or any Webhook URL (POSTs JSON payload)
NOTIFICATION_WEBHOOK_URL=

# ===== Cloudflare Workers =====
# D1 Database ID (create with: npx wrangler d1 create anixops)
D1_DATABASE_ID=

# KV Namespace ID (create with: npx wrangler kv:namespace create anixops-cache)
KV_NAMESPACE_ID=

# ===== Security =====
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===== Development =====
# Worker API URL for local dev (can be empty in production, same domain)
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8787
