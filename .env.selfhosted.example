# AnixOps self-hosted environment
# Copy to .env.selfhosted, edit values, then run:
# docker compose --env-file .env.selfhosted -f docker-compose.selfhosted.yml up -d

# Public URLs
FRONTEND_URL=http://localhost:30000
ALLOWED_ORIGINS=http://localhost:30000
WEB_PORT=30000
# Leave empty to use the built-in Next.js /api proxy.
NEXT_PUBLIC_WORKER_URL=

# Internal service secrets
PROVISION_SERVER_TOKEN=change-me-min-32-random-chars
API_SECRET=change-me-admin-secret
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password
ADMIN_EMAILS=

# Chain-backed features mode
# Keep test servers on testnet and restrict them to a small email allowlist.
CHAIN_ENVIRONMENT=testnet
CHAIN_TESTNET_WHITELIST_EMAILS=

# Optional Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional renewal/reminder webhook
NOTIFICATION_WEBHOOK_URL=

# SMTP for magic-link login
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=

# Optional cloud-provider defaults for rental provisioning
# Keep Vultr, DigitalOcean, and AWS adapters available; current default stays on Vultr.
CLOUD_PROVIDER=vultr
VPS_REGION=nrt
VPS_PLAN=vhf-1c-1gb
VULTR_API_KEY=
DIGITALOCEAN_TOKEN=
# Legacy alias still accepted for existing installs: DO_API_TOKEN
DO_API_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SECURITY_GROUP_ID=

# Optional chain-backed crypto topup settings
# Test-server default: Base Sepolia + mock USDT + whitelist emails.
# Fastest setup from the repo root:
# npm run crypto:bootstrap-testnet -- --chain base-sepolia --whitelist-emails qa@example.com --write-env
# See docs/manual-input-checklist.md and docs/evm-testnet-playbook.md.
CRYPTO_TOPUP_CHAIN=base
CRYPTO_TOPUP_ASSET=USDT
CRYPTO_TOPUP_CONFIRMATIONS_REQUIRED=12
CRYPTO_TOPUP_RPC_URL=https://sepolia.base.org
CRYPTO_TOPUP_SIGNER_PRIVATE_KEY=
CRYPTO_TOPUP_RECEIVER_ADDRESS=
CRYPTO_TOPUP_TOKEN_ADDRESS=
CRYPTO_TOPUP_TOKEN_DECIMALS=6
CRYPTO_TOPUP_PROVIDER_API_KEY=
FX_PROVIDER_API_KEY=

# Optional chain-backed audit anchor settings
# Fill these only when you are ready to send real on-chain anchor transactions.
AUDIT_ANCHOR_CHAIN=base
AUDIT_ANCHOR_RPC_URL=https://sepolia.base.org
AUDIT_ANCHOR_SIGNER_PRIVATE_KEY=
AUDIT_ANCHOR_TARGET_ADDRESS=
AUDIT_ANCHOR_MIN_NATIVE_BALANCE=

# Optional alert hooks for crypto / anchor automation
CRYPTO_ALERT_WEBHOOK_URL=
AUDIT_ANCHOR_ALERT_WEBHOOK_URL=

# Self-hosted scheduler intervals.
# billing/compliance run by default; crypto/audit run in auto mode only when their required chain env is complete.
BILLING_TICK_CRON=*/5 * * * *
CRYPTO_TOPUP_CRON=*/2 * * * *
AUDIT_ANCHOR_CRON=17 * * * *
COMPLIANCE_STATS_CRON=*/15 * * * *
SCHEDULER_ENABLE_BILLING_TICK=true
SCHEDULER_ENABLE_CRYPTO_TOPUPS=auto
SCHEDULER_ENABLE_AUDIT_ANCHOR=auto
SCHEDULER_ENABLE_COMPLIANCE_STATS=true
